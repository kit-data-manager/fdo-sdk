{
    "mcp": {
        "servers": {
            "playwright": {
                "type": "local",
                "command": ["pnpm", "dlx", "@playwright/mcp@latest"]
            },
            "firefox-devtools": {
                "type": "local",
                "command": [
                    "pnpm",
                    "dlx",
                    "@mozilla/firefox-devtools-mcp@latest"
                ]
            }
        }
    }
}
